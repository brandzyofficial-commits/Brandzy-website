# Cloudflare Pages response headers (ignored by GitHub Pages).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/app/*
  X-Robots-Tag: noindex

# The app's loader script and page name the current (hashed) .wasm files, so they must never be
# served from cache: a stale copy asks for .wasm files an update removed and the page stays blank.
/app/
  Cache-Control: no-cache

/app/index.html
  Cache-Control: no-cache

/app/composeApp.js
  Cache-Control: no-cache
